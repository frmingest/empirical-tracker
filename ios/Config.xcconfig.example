// EmpiricalTracker — backend configuration template.
//
// HOW TO USE
//   1. Copy this file to `Config.xcconfig` (same directory).
//        cp Config.xcconfig.example Config.xcconfig
//   2. Fill in the three values below with your real project coordinates.
//   3. In Xcode: select the project ▸ Info ▸ Configurations ▸ set
//      `Config.xcconfig` as the configuration file for both Debug and Release
//      of the `EmpiricalTracker` target.
//   4. Clean build folder (⇧⌘K) and rebuild.
//
// `Config.xcconfig` is git-ignored — your real keys never get committed.
// The anon key is a *public* client key (safe to ship in the app binary);
// it is NOT the Supabase service-role/secret key. Never put the service-role
// key here or anywhere in the iOS app.

// --- Supabase (auth) -------------------------------------------------------
// Project ▸ Settings ▸ API in the Supabase dashboard.
SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLIC_ANON_KEY

// --- Backend REST API (Railway) -------------------------------------------
// The FastAPI service base URL. Must be reachable over HTTPS and serve the
// `/biomarkers`, `/diet-events`, `/settings`, etc. routes.
// NOTE: this is consumed via the EMPIRICAL_API_URL process env in APIClient;
// to feed it from xcconfig, also add it as an environment variable in the
// Run scheme, OR wire APIClient to read it from Info.plist (see CONFIGURATION.md).
EMPIRICAL_API_URL = https://YOUR_API.up.railway.app
