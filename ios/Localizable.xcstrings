{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "—" : {
      "comment" : "A placeholder text used when there is no available data for a biomarker.",
      "isCommentAutoGenerated" : true
    },
    "(%lld)" : {
      "comment" : "A subtitle below a section header that shows the number of items in that section.",
      "isCommentAutoGenerated" : true
    },
    "(continued)" : {
      "comment" : "A text indicating that a list of items is split across multiple pages.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A value for a food macro, displayed in a The first argument is the string “%.1f”. The second argument is the string “food.unit.kcal” or the string “food.unit.g”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ avg" : {
      "comment" : "Value axis label for the moving average line.",
      "isCommentAutoGenerated" : true
    },
    "%@ trend chart with %lld measurements." : {
      "comment" : "A label describing the content of the view, including the name of the biomarker and the number of measurements.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ trend chart with %2$lld measurements."
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "A button that, when tapped, describes the region and its accessibility status. The argument is the string “no data”, the string “out of range”, the string “watch”, the string “in range” or the string “unknown”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@. %@" : {
      "comment" : "Combines the title and detail of a biomarker signal into a single accessible label.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A text label showing the number of biomarkers that are out of range. The number is dynamically replaced with the actual count.",
      "isCommentAutoGenerated" : true
    },
    "%lld out of range" : {
      "comment" : "A label describing the number of biomarkers that are out of range. The argument is the count of such biomarkers.",
      "isCommentAutoGenerated" : true
    },
    "%lld result%@ selected" : {
      "comment" : "A label showing the number of selected results. If no results are selected, it shows \"No results selected\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld result%2$@ selected"
          }
        }
      }
    },
    "%lld selected" : {
      "comment" : "A summary of the number of biomarkers that have been selected for display in Custom mode.",
      "isCommentAutoGenerated" : true
    },
    "3+ tested" : {
      "comment" : "A filter option that selects only biomarkers that have been tested by at least three patients.",
      "isCommentAutoGenerated" : true
    },
    "About %@: %@" : {
      "comment" : "An accessibility label that combines the category name with its summary.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About %1$@: %2$@"
          }
        }
      }
    },
    "Add manual result" : {
      "comment" : "A button label that suggests adding a manual result for a biomarker.",
      "isCommentAutoGenerated" : true
    },
    "Add result" : {
