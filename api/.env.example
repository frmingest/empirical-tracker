# Copy to .env and fill in. Never commit the real .env.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Supabase (Sprint 1+).
SUPABASE_URL=
# Service-role key — server-only, keep it secret. Bypasses RLS; used ONLY for
# account erasure (ADR-026).
SUPABASE_SERVICE_KEY=
# Public anon key — the same key the iOS app ships (not a secret), now also
# required on the API: it builds per-request, JWT-scoped clients so user-data
# queries run under Postgres RLS instead of as the service role (ADR-026).
SUPABASE_ANON_KEY=

# USDA FoodData Central (ADR-018). Free key from https://fdc.nal.usda.gov/api-key-signup
# Server-only — never exposed to the browser. If unset, the USDA whole-food
# source simply returns no results (the other sources keep working).
USDA_FDC_API_KEY=

# Anthropic — used by the nutrition-label OCR parser (/food/parse-label).
# When unset the endpoint returns 503. Set in Railway env vars for production.
ANTHROPIC_API_KEY=
